#usda 1.0
(
    defaultPrim = "remote"
    metersPerUnit = 1
    kilogramsPerUnit = 1
    upAxis = "Z"
    doc = "Face-down two-AAA TV remote with the battery cover removed"
)

# Face-down two-AAA TV remote, likeness of ASIN B07T4N7NTX. Not measured CAD.
# Listing: 23.5 x 4.8 x 2.4 cm, black ABS, two AAA. Bay geometry is ESTIMATED.
# channel_width_m = 0.013
# lateral_clearance_m = 0.0012499999999999994
# seated_rim_margin_m = 0.0009999999999999974
# bay_length_m = 0.0595
# drop_slack_m = 0.0025
# spring_preload_m = 0.0015
# contact_offset_m = 0.0003
# plunger_travel_m = 0.004
# silhouette_length_m = 0.235
# Cover removed: the bay is open from above. The spring is at each slot's negative end.
# Fixed base: root_joint (PhysicsFixedJoint) anchors the chassis, which is the articulation root.
# Colliders are guide-purpose (not rendered); the shell, contacts, marks, and coils are visual only.
# Plungers are prismatic joints; +joint compresses the spring. The battery is not parented here.
# single_slot omits slot_b. Joint 0 is the extended pose authored below.
def Xform "remote"
{
    def Material "physics_material" (
        prepend apiSchemas = ["PhysicsMaterialAPI"]
    )
    {
        float physics:staticFriction = 0.5
        float physics:dynamicFriction = 0.4
        float physics:restitution = 0
    }
    def Scope "Looks"
    {
        def Material "black_abs"
        {
            token outputs:surface.connect = </remote/Looks/black_abs/surface.outputs:surface>
            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.018, 0.018, 0.02)
                float inputs:roughness = 0.38
                float inputs:metallic = 0
                token outputs:surface
            }
        }
        def Material "nickel"
        {
            token outputs:surface.connect = </remote/Looks/nickel/surface.outputs:surface>
            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.72, 0.71, 0.68)
                float inputs:roughness = 0.22
                float inputs:metallic = 1
                token outputs:surface
            }
        }
        def Material "moulded_mark"
        {
            token outputs:surface.connect = </remote/Looks/moulded_mark/surface.outputs:surface>
            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.3, 0.3, 0.31)
                float inputs:roughness = 0.55
                float inputs:metallic = 0
                token outputs:surface
            }
        }
        def Material "spring_steel"
        {
            token outputs:surface.connect = </remote/Looks/spring_steel/surface.outputs:surface>
            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.62, 0.62, 0.64)
                float inputs:roughness = 0.3
                float inputs:metallic = 1
                token outputs:surface
            }
        }
    }
    def Xform "chassis" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxRigidBodyAPI", "MaterialBindingAPI", "PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
