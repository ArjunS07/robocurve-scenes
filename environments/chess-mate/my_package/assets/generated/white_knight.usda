#usda 1.0
(
    defaultPrim = "piece"
    metersPerUnit = 1
    kilogramsPerUnit = 1
    upAxis = "Z"
    doc = "Provisional knight. Origin is the center of the bottom face. The mesh stays inside the base radius."
)

def Xform "piece" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxRigidBodyAPI"]
)
{
    float physics:mass = 0.015
    float physics:staticFriction = 0.55
    float physics:dynamicFriction = 0.4
    float physics:restitution = 0.02
    int physxRigidBody:solverPositionIterationCount = 16
    int physxRigidBody:solverVelocityIterationCount = 1
    def Cylinder "base" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        uniform token axis = "Z"
        double height = 0.00792
        double radius = 0.01
        double3 xformOp:translate = (0, 0, 0.00396)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        color3f[] primvars:displayColor = [(0.86, 0.75, 0.55)]
        float physxCollision:contactOffset = 0.0003
    }
    def Cylinder "stem" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        uniform token axis = "Z"
        double height = 0.01848
        double radius = 0.0042
        double3 xformOp:translate = (0, 0, 0.01716)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        color3f[] primvars:displayColor = [(0.86, 0.75, 0.55)]
        float physxCollision:contactOffset = 0.0003
    }
    def Cube "head" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        double size = 1
        double3 xformOp:translate = (0.0025, 0, 0.03344)
        float3 xformOp:scale = (0.007, 0.0055, 0.01408)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        color3f[] primvars:displayColor = [(0.86, 0.75, 0.55)]
        float physxCollision:contactOffset = 0.0003
    }
}
