#usda 1.0
(
    defaultPrim = "marks"
    metersPerUnit = 1
    upAxis = "Z"
    doc = "Visual outline of the board mark. No physics and no mating-square marker."
)

def Xform "marks"
{
    def Cube "board_mark"
    {
        double size = 1
        double3 xformOp:translate = (0.48, 0, 0.7504)
        float3 xformOp:scale = (0.32, 0.32, 0.0004)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        color3f[] primvars:displayColor = [(0.15, 0.45, 0.22)]
    }
}
