#usda 1.0
(
    defaultPrim = "piece"
    metersPerUnit = 1
    kilogramsPerUnit = 1
    upAxis = "Z"
    doc = "Provisional bishop. Origin is the center of the bottom face. The mesh stays inside the base radius."
)

def Xform "piece" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxRigidBodyAPI"]
)
{
    float physics:mass = 0.014
    float physics:staticFriction = 0.55
    float physics:dynamicFriction = 0.4
    float physics:restitution = 0.02
    int physxRigidBody:solverPositionIterationCount = 16
    int physxRigidBody:solverVelocityIterationCount = 1
    def Cylinder "base" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        uniform token axis = "Z"
        double height = 0.00864
        double radius = 0.01
        double3 xformOp:translate = (0, 0, 0.00432)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        color3f[] primvars:displayColor = [(0.86, 0.75, 0.55)]
        float physxCollision:contactOffset = 0.0003
    }
    def Cylinder "stem" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        uniform token axis = "Z"
        double height = 0.02016
        double radius = 0.0042
        double3 xformOp:translate = (0, 0, 0.01872)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        color3f[] primvars:displayColor = [(0.86, 0.75, 0.55)]
        float physxCollision:contactOffset = 0.0003
    }
    def Cylinder "head" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        uniform token axis = "Z"
        double height = 0.01536
        double radius = 0.0072
        double3 xformOp:translate = (0, 0, 0.03648)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        color3f[] primvars:displayColor = [(0.86, 0.75, 0.55)]
        float physxCollision:contactOffset = 0.0003
    }
}
